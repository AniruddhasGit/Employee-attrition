# Copy to .env and adjust. Never commit .env.
# Local defaults below match docker-compose.yml; use real values only in your host's secret store.

# API
DATABASE_URL=postgresql+psycopg://retain:retain@localhost:5433/retain
IP_HASH_SALT=change-me-to-a-long-random-string
MODELS_DIR=models
# The web app's own origin(s): writes from anywhere else are refused (CSRF guard).
SITE_ORIGINS=http://localhost:3000
# Shared with the web app so the API can trust the client IP it forwards. Long and random.
PROXY_SECRET=change-me-to-another-long-random-string
# true in production (HTTPS only cookies)
COOKIE_SECURE=false
# Password for the five public demo accounts
DEMO_PASSWORD=retain-demo

# Web (server-side, read at runtime)
API_ORIGIN=http://localhost:8010
